{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/email",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/push",
      "schedule": "0 9 * * *"
    }
  ]
}
